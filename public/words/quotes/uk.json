[
 {
  "text": "Тиха вода греблю рве.",
  "source": "Українське прислів'я"
 },
 {
  "text": "Не все те золото, що блищить.",
  "source": "Українське прислів'я"
 },
 {
  "text": "Яблуко від яблуні недалеко падає.",
  "source": "Українське прислів'я"
 },
 {
  "text": "Друзі пізнаються в біді.",
  "source": "Українське прислів'я"
 },
 {
  "text": "Хто не працює, той не їсть.",
  "source": "Українське прислів'я"
 },
 {
  "text": "Краще пізно, ніж ніколи.",
  "source": "Українське прислів'я"
 },
 {
  "text": "Без труда нема плода.",
  "source": "Українське прислів'я"
 },
 {
  "text": "Слово не горобець, вилетить — не спіймаєш.",
  "source": "Українське прислів'я"
 },
 {
  "text": "Гостей запрошай, а хату прибирай.",
  "source": "Українське прислів'я"
 },
 {
  "text": "Вік живи, вік учись.",
  "source": "Українське прислів'я"
 },
 {
  "text": "Реве та стогне Дніпр широкий.",
  "source": "Тарас Шевченко, Кобзар"
 },
 {
  "text": "Борітеся — поборете!",
  "source": "Тарас Шевченко, Кобзар"
 },
 {
  "text": "Учітесь, читайте, і чужому научайтесь, і свого не цурайтесь.",
  "source": "Тарас Шевченко"
 },
 {
  "text": "Кожна людина коваль своєї долі.",
  "source": "Українське прислів'я"
 },
 {
  "text": "Що посієш, те й пожнеш.",
  "source": "Українське прислів'я"
 },
 {
  "text": "Дорога ложка до обіду.",
  "source": "Українське прислів'я"
 },
 {
  "text": "Не кажи гоп, поки не перескочиш.",
  "source": "Українське прислів'я"
 },
 {
  "text": "У дружній сім'ї і в холод тепло.",
  "source": "Українське прислів'я"
 },
 {
  "text": "Хто шукає, той завжди знайде.",
  "source": "Українське прислів'я"
 },
 {
  "text": "Мова — це доля народу.",
  "source": "Панас Мирний"
 }
]
