[
{
"text": "الصبر مفتاح الفرج.",
"source": "مثل عربي"
},
{
"text": "من جد وجد ومن زرع حصد.",
"source": "مثل عربي"
},
{
"text": "العلم نور والجهل ظلام.",
"source": "مثل عربي"
},
{
"text": "درهم وقاية خير من قنطار علاج.",
"source": "مثل عربي"
},
{
"text": "الوقت كالسيف إن لم تقطعه قطعك.",
"source": "مثل عربي"
},
{
"text": "من طلب العلا سهر الليالي.",
"source": "المتنبي"
},
{
"text": "رب أخ لم تلده أمك.",
"source": "مثل عربي"
},
{
"text": "الحياة كفاح.",
"source": "مثل عربي"
},
{
"text": "خير الكلام ما قل ودل.",
"source": "مثل عربي"
},
{
"text": "لا تؤجل عمل اليوم إلى الغد.",
"source": "مثل عربي"
},
{
"text": "الاتحاد قوة.",
"source": "مثل عربي"
},
{
"text": "من حفر حفرة لأخيه وقع فيها.",
"source": "مثل عربي"
},
{
"text": "الصديق وقت الضيق.",
"source": "مثل عربي"
},
{
"text": "كل إناء بما فيه ينضح.",
"source": "مثل عربي"
},
{
"text": "العقل السليم في الجسم السليم.",
"source": "مثل عربي"
},
{
"text": "الجار قبل الدار.",
"source": "مثل عربي"
},
{
"text": "قطرة قطرة يتكون البحر.",
"source": "مثل عربي"
},
{
"text": "من قل صبره قل نصره.",
"source": "مثل عربي"
},
{
"text": "العين لا تعلو على الحاجب.",
"source": "مثل عربي"
},
{
"text": "إذا كان الكلام من فضة فالسكوت من ذهب.",
"source": "مثل عربي"
}
]