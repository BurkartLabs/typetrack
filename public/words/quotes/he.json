[
{
"text": "אם אין אני לי מי לי.",
"source": "פרקי אבות"
},
{
"text": "כל ישראל ערבים זה בזה.",
"source": "פתגם עברי"
},
{
"text": "אין חכם כבעל הניסיון.",
"source": "פתגם עברי"
},
{
"text": "הזמן הוא הכסף היקר ביותר.",
"source": "פתגם עברי"
},
{
"text": "אחרי הרגליים נמשכות העיניים.",
"source": "פתגם עברי"
},
{
"text": "כל ההתחלות קשות.",
"source": "פתגם עברי"
},
{
"text": "אין דבר העומד בפני הרצון.",
"source": "פתגם עברי"
},
{
"text": "מים גנובים ימתקו.",
"source": "משלי"
},
{
"text": "אל תדון את חברך עד שתגיע למקומו.",
"source": "פרקי אבות"
},
{
"text": "טוב שם משמן טוב.",
"source": "קהלת"
},
{
"text": "אשרי אדם מצא חכמה.",
"source": "משלי"
},
{
"text": "לכל זמן ועת לכל חפץ.",
"source": "קהלת"
},
{
"text": "מה שהיה הוא שיהיה.",
"source": "קהלת"
},
{
"text": "שתיקה כהודאה.",
"source": "פתגם עברי"
},
{
"text": "אין אדם רואה חובה לעצמו.",
"source": "פתגם עברי"
},
{
"text": "כל המציל נפש אחת כאילו הציל עולם מלא.",
"source": "משנה"
},
{
"text": "עולם חסד יבנה.",
"source": "תהלים"
},
{
"text": "טובים השניים מן האחד.",
"source": "קהלת"
},
{
"text": "לא עליך המלאכה לגמור.",
"source": "פרקי אבות"
},
{
"text": "אין קמח אין תורה.",
"source": "פרקי אבות"
}
]